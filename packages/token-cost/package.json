{
  "name": "@clawsjoy/dsh-token-cost",
  "version": "0.1.1",
  "description": "A ctx.tokenCost service converting token usage to cost with configurable pricing.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ClawsJoy/dsh-plugins.git",
    "directory": "packages/token-cost"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/*.js",
    "lib/types/**/*.d.ts",
    "README.md"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cost",
    "tokens"
  ],
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
